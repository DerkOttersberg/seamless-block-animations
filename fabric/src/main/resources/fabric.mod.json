{
  "schemaVersion": 1,
  "id": "seamless_block_animations",
  "provides": ["fresh-interactiable-animations"],
  "version": "${version}",
  "name": "Seamless Block Animations",
  "description": "Smooth client-side door, trapdoor, and fence-gate animations using resource-pack models.",
  "authors": ["Derk Ottersberg"],
  "contact": {
    "sources": "https://github.com/DerkOttersberg/seamless-block-animations",
    "issues": "https://github.com/DerkOttersberg/seamless-block-animations/issues"
  },
  "license": "CC0-1.0",
  "icon": "assets/seamless_block_animations/icon.png",
  "environment": "client",
  "entrypoints": {
    "client": ["io.github.derkottersberg.seamlessblockanimations.fabric.SeamlessBlockAnimationsFabric"]
  },
  "mixins": ["seamless_block_animations.mixins.json"],
  "depends": {
    "fabricloader": ">=0.19.3",
    "fabric-api": "*",
    "minecraft": "~26.2",
    "java": ">=25"
  }
}
